{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["puter"],
  "model": "puter/ling-3.0-flash",
  "agent": {
    "build": {
      "model": "puter/ling-3.0-flash",
      "prompt": "You are the master agent and always use Ling 3.0 Flash. Use puter-glm-1 through puter-glm-7 for delegated text, coding, repository, and tool tasks. Use puter-vision-1 through puter-vision-7 for every image, screenshot, visual document, or PDF analysis. These are interchangeable pools, not fixed allocations. You may start at most seven subagents total for one task across both pools; distribute those seven slots according to the work, wait for them, and consolidate their results. Never analyze visual input yourself when a vision subagent is available.",
      "permission": {
        "task": {
          "*": "deny",
          "puter-glm-1": "allow", "puter-glm-2": "allow", "puter-glm-3": "allow", "puter-glm-4": "allow", "puter-glm-5": "allow", "puter-glm-6": "allow", "puter-glm-7": "allow",
          "puter-vision-1": "allow", "puter-vision-2": "allow", "puter-vision-3": "allow", "puter-vision-4": "allow", "puter-vision-5": "allow", "puter-vision-6": "allow", "puter-vision-7": "allow"
        }
      }
    },
    "puter-glm-1": { "description": "GLM 4.7 Flash subagent for delegated text, coding, repository, and tool tasks.", "mode": "subagent", "model": "puter/glm-4.7-flash", "steps": 12, "permission": { "task": "deny" } },
    "puter-glm-2": { "description": "GLM 4.7 Flash subagent for delegated text, coding, repository, and tool tasks.", "mode": "subagent", "model": "puter/glm-4.7-flash", "steps": 12, "permission": { "task": "deny" } },
    "puter-glm-3": { "description": "GLM 4.7 Flash subagent for delegated text, coding, repository, and tool tasks.", "mode": "subagent", "model": "puter/glm-4.7-flash", "steps": 12, "permission": { "task": "deny" } },
    "puter-glm-4": { "description": "GLM 4.7 Flash subagent for delegated text, coding, repository, and tool tasks.", "mode": "subagent", "model": "puter/glm-4.7-flash", "steps": 12, "permission": { "task": "deny" } },
    "puter-glm-5": { "description": "GLM 4.7 Flash subagent for delegated text, coding, repository, and tool tasks.", "mode": "subagent", "model": "puter/glm-4.7-flash", "steps": 12, "permission": { "task": "deny" } },
    "puter-glm-6": { "description": "GLM 4.7 Flash subagent for delegated text, coding, repository, and tool tasks.", "mode": "subagent", "model": "puter/glm-4.7-flash", "steps": 12, "permission": { "task": "deny" } },
    "puter-glm-7": { "description": "GLM 4.7 Flash subagent for delegated text, coding, repository, and tool tasks.", "mode": "subagent", "model": "puter/glm-4.7-flash", "steps": 12, "permission": { "task": "deny" } },
    "puter-vision-1": { "description": "GLM 4.6V Flash vision and document subagent.", "mode": "subagent", "model": "puter/z-ai/glm-4.6v-flash", "steps": 12, "permission": { "task": "deny" } },
    "puter-vision-2": { "description": "GLM 4.6V Flash vision and document subagent.", "mode": "subagent", "model": "puter/z-ai/glm-4.6v-flash", "steps": 12, "permission": { "task": "deny" } },
    "puter-vision-3": { "description": "GLM 4.6V Flash vision and document subagent.", "mode": "subagent", "model": "puter/z-ai/glm-4.6v-flash", "steps": 12, "permission": { "task": "deny" } },
    "puter-vision-4": { "description": "GLM 4.6V Flash vision and document subagent.", "mode": "subagent", "model": "puter/z-ai/glm-4.6v-flash", "steps": 12, "permission": { "task": "deny" } },
    "puter-vision-5": { "description": "GLM 4.6V Flash vision and document subagent.", "mode": "subagent", "model": "puter/z-ai/glm-4.6v-flash", "steps": 12, "permission": { "task": "deny" } },
    "puter-vision-6": { "description": "GLM 4.6V Flash vision and document subagent.", "mode": "subagent", "model": "puter/z-ai/glm-4.6v-flash", "steps": 12, "permission": { "task": "deny" } },
    "puter-vision-7": { "description": "GLM 4.6V Flash vision and document subagent.", "mode": "subagent", "model": "puter/z-ai/glm-4.6v-flash", "steps": 12, "permission": { "task": "deny" } }
  },
  "provider": {
    "puter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Puter free models",
      "options": {
        "baseURL": "http://127.0.0.1:8765/v1",
        "apiKey": "{env:PUTER_BRIDGE_TOKEN}"
      },
      "models": {
        "ling-3.0-flash": { "name": "Ling 3.0 Flash via Puter", "limit": { "context": 262144, "output": 32768 } },
        "glm-4.7-flash": { "name": "GLM-4.7 Flash via Puter", "limit": { "context": 131072, "output": 8192 } },
        "z-ai/glm-4.6v-flash": { "name": "Z.AI GLM 4.6V Flash via Puter", "limit": { "context": 128000, "output": 8192 } }
      }
    }
  }
}
